#: pretix_csob/templates/pretix_csob/checkout_payment_confirm.html:11
msgid "Please click on the \"Pay now\" button below to confirm your payment."
msgstr "Zmáčkněte tlačítko \"Zaplatit nyní\" níže pro potvrzení platby."

