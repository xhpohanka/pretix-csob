#: pretix_csob/templates/pretix_csob/checkout_payment_confirm.html:18
msgid ""
"The total amount listed above will be withdrawn from your account after the "
"confirmation of your purchase."
msgstr "Celková částka uvedená výše bude po potvrzení nákupu stržena z vašeho účtu."

#: pretix_csob/templates/pretix_csob/payment_pending.html:1
